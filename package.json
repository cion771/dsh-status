{
  "name": "@local/dsh-status",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "AI API Status: one pill in the top-right of the Harness conversation header that follows the session model and shows the matching provider status (DeepSeek, GPT/OpenAI, Claude/Anthropic).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cion771/dsh-status.git"
  },
  "homepage": "https://github.com/cion771/dsh-status#readme",
  "keywords": [
    "deepseek",
    "openai",
    "anthropic",
    "claude",
    "status-page",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
